# Copy these values into your shell. Replace only the endpoint and measured metadata.
$env:ROUTING_POLICY="hybrid"
$env:MAX_ATTEMPTS="2"
$env:CIRCUIT_BREAKER_FAILURES="3"
$env:CIRCUIT_BREAKER_COOLDOWN_MS="10000"

# id|transport|tier|model|target|quality|latency_ms|usd_per_1k|local|region|key_env|health_url
# Measured on the committed 50-row GSM8K run on 2026-08-31; recalibrate for a different workload.
$env:GOOGLE_THINKING_LEVEL="minimal"
$env:ENDPOINTS="gemma-e2b-local|grpc|fast|google/gemma-4-E2B-it|localhost:50052|0.44|3077|0.0|true|local||,gemma-api|google|premium|gemma-4-31b-it|https://generativelanguage.googleapis.com/v1beta/models/gemma-4-31b-it:generateContent|0.94|6042|0.0|false|global|GEMINI_API_KEY|"

# Leave this unset when running entirely locally. With no key, the remote endpoint is
# deliberately not ready and the router falls back to an eligible local endpoint.
# $env:GEMINI_API_KEY="replace-me"
